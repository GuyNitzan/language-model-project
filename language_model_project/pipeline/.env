# Copy this file to .env and fill in your keys before running steps 3 and 4.

# Required for step 3 (embedding generation)
OPENAI_API_KEY=your_openai_api_key_here

# Required for step 4 (vector DB ingestion)
# For local Qdrant (docker): leave QDRANT_URL as default, no API key needed.
# For Qdrant Cloud: set the cluster URL and API key from your cloud dashboard.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
